# Supabase (used by both Python sync jobs and the Next.js app)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Next.js public Supabase (browser reads, RLS-protected)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here

# Google Gemini LLM (free tier)
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Optional: rate limiting via Upstash Redis
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Comma-separated emails allowed to access /admin in the Next.js app
ADMIN_EMAILS=

# Next.js only: if fantasy.premierleague.com returns 403 for server-side FPL fetches
# (cloud/datacenter IPs), set to a current desktop Chrome User-Agent string.
# FPL_FETCH_USER_AGENT=

# Full browser Cookie while logged into fantasy.premierleague.com — legacy deploy-wide fallback for /my-team/.
# Prefer per-user connect in Account settings (user_fpl_credentials table).
# FPL_SESSION_COOKIE=

# FFS China trial — affiliate / CTA destinations (optional overrides)
# FFS_PREMIUM_URL=https://www.fantasyfootballscout.co.uk/register
# FFS_TEAM_RATER_URL=https://www.fantasyfootballscout.co.uk/how-to-use-our-rate-my-team-tool-to-get-your-fpl-squad-rated

# Optional: logged-in Fantasy Football Scout Cookie header so ingest can store
# the full article (anonymous HTML/REST/RSS are truncated at the free-account
# teaser). Paste the whole Cookie value from Chrome DevTools — never commit it.
# Chrome: log into fantasyfootballscout.co.uk → open any article → F12 →
# Network → click the document request → Request Headers → Cookie → copy.
# FFS_SESSION_COOKIE=
# Alias: FFS_AUTH_COOKIE=
# Also set the same secret in GitHub Actions (FFS_SESSION_COOKIE) and
# Cloudflare Workers & Pages → Variables (for /admin ingest).

# Optional: encrypt per-user FPL cookies (32-byte key as hex or base64).
# FPL_CREDENTIALS_KEY=

# Optional: calendar year when the FPL game season starts (e.g. 2026 for 2026/27).
# Overrides bootstrap-derived season for Python sync + Next.js DB queries if set.
# FPL_CURRENT_SEASON=

